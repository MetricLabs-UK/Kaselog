# APP_DEBUG must only be true when APP_URL is a genuine local dev address
# (http://localhost, http://127.0.0.1, or a *.test / *.localhost domain like
# Laragon's auto-generated http://<project>.test). The moment APP_URL points
# at a real/deployed domain, APP_DEBUG must be false — with it on, visitors
# get full stack traces (including config and query details) on any error.
# AppServiceProvider::preventDebugModeOnNonLocalUrl() forces this off as a
# safety net if it's ever misconfigured, but don't rely on that — set it
# correctly here. APP_ENV should be "local" for dev, "production" for a real
# deploy; LOG_LEVEL below should also drop from "debug" to something quieter
# (e.g. "error") in production to cut noise.
#
# The same "is APP_URL a genuine local address" check (App\Support\
# Environment) also drives two more things automatically, with no separate
# env var needed here: the session cookie's Secure flag (config/session.php
# — set SESSION_SECURE_COOKIE explicitly only if you need to override the
# derived default) and App\Http\Middleware\ForceHttps, which redirects a
# plain-http request to https once APP_URL stops looking local. If this app
# ends up behind a reverse proxy/load balancer that terminates TLS, see
# bootstrap/app.php's trustProxies() comment before relying on that redirect
# — it needs the proxy's real IP(s) configured or it can't tell a request
# arrived over HTTPS at all.
APP_NAME=Kaselog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production mailer: Microsoft 365 SMTP relay via the firm's own mailbox.
# - MAIL_USERNAME/MAIL_FROM_ADDRESS must be the full mailbox address (or a
#   "Send As" alias on it) — M365 rejects or silently rewrites a From address
#   that doesn't match the authenticated account.
# - MAIL_PASSWORD: the mailbox's app password, not its normal sign-in
#   password, if the account has MFA enabled (the usual case). If SMTP AUTH
#   is disabled tenant- or mailbox-wide (Microsoft has been turning this off
#   by default), ask the M365 admin to enable "Authenticated SMTP" for this
#   mailbox in the Exchange admin center first — sends will fail until then.
# - Locally, leave MAIL_MAILER=log (below) so nothing tries to send real mail
#   during development.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Section 20 — real two-way Xero sync, one Kase-wide app registration that
# each firm individually authorizes their own Xero organisation against (see
# App\Support\Accounting\Xero\XeroAccountingProvider). From the Xero
# Developer portal (developer.xero.com/app/manage), under this app's own
# registration:
# XERO_CLIENT_ID / XERO_CLIENT_SECRET — Configuration tab. Also register the
#   redirect URI there: {APP_URL}/integrations/accounting/xero/callback
# XERO_WEBHOOK_SECRET — Webhooks tab. Also register the webhook delivery URL
#   there: {APP_URL}/webhooks/xero (already a live route; it rejects
#   everything until this is set to the real value)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_WEBHOOK_SECRET=
RETELL_WEBHOOK_SECRET=
RETELL_API_KEY=

# TWILIO_FROM_NUMBER must be a number provisioned in your Twilio account
# (Console > Phone Numbers), not an arbitrary string — Twilio rejects sends
# from a number it doesn't own. SmsService (payment chase tiers 3-4, lead
# nurture stage 2, portal invite) no-ops safely with these blank in local
# dev only in the sense that a send attempt will fail loudly (and get
# logged) rather than pretend to succeed — see SmsService's own docblock.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Section 12 (Backup & Disaster Recovery) — SharePoint destination for
# spatie/laravel-backup, via App\Providers\FlySystemSharepointProvider +
# gwsn/flysystem-sharepoint-adapter. All four require an Azure AD app
# registration with Microsoft Graph *application* (not delegated)
# permission Sites.ReadWrite.All, admin-consented — see
# docs/backup-and-restore.md for the full one-time setup checklist.
# SHAREPOINT_TENANT_ID  — Azure AD > Overview > Tenant ID
# SHAREPOINT_CLIENT_ID  — the app registration's Application (client) ID
# SHAREPOINT_CLIENT_SECRET — a client secret *value* (not the secret ID)
#   generated under that app's Certificates & secrets — only shown once
# SHAREPOINT_SITE — the SharePoint site name (not a URL or GUID) that
#   GWSN\FlysystemSharepoint\SharepointConnector resolves via Graph at
#   connection time
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE=
SHAREPOINT_PREFIX=backups

# Firm-facing self-service backup's SharePoint destination (App\Support\
# Backups\SharePoint\SharePointBackupProvider) — a SECOND, SEPARATE Azure AD
# app registration from SHAREPOINT_* above. That one is a single app-only
# (client_credentials) registration for Kase's own internal backup; this one
# must be multi-tenant with DELEGATED permissions, since each firm
# individually authorizes their own Microsoft 365 account against it (same
# per-firm-OAuth shape as XERO_CLIENT_ID/SECRET above, not Section 12's
# SharePoint setup). From a new Azure AD app registration:
# - Supported account types: Accounts in any organizational directory
#   (Multitenant)
# - API permissions (delegated, Microsoft Graph): offline_access,
#   Sites.ReadWrite.All — admin consent not required, each firm consents
#   for themselves during connect. Sites.ReadWrite.All (not Files.
#   ReadWrite.All) because this uploads to a firm-chosen SHARED SharePoint
#   site the firm searches and picks after connecting (App\Support\Backups\
#   SharePoint\SharePointBackupProvider::searchDestinations()/
#   selectDestination()), not the connecting individual's own OneDrive.
# - Redirect URI (Web): {APP_URL}/integrations/backups/sharepoint/callback
# - AZURE_BACKUP_CLIENT_ID — the app registration's Application (client) ID
# - AZURE_BACKUP_CLIENT_SECRET — a client secret *value* (not the secret ID)
#   generated under Certificates & secrets — only shown once
AZURE_BACKUP_CLIENT_ID=
AZURE_BACKUP_CLIENT_SECRET=

# Firm-facing self-service backup's Google Drive destination (App\Support\
# Backups\GoogleDrive\GoogleDriveBackupProvider) — this app's first Google
# integration of any kind, so this is a brand new Google Cloud project/OAuth
# client, not an extension of anything existing. From Google Cloud Console
# (console.cloud.google.com), for a project dedicated to (or shared with)
# this app:
# - APIs & Services > Library: enable the "Google Drive API"
# - APIs & Services > OAuth consent screen: External user type (so any
#   firm's Google Workspace account can consent, not just your own
#   organization's), publish it (a consent screen stuck in "Testing" only
#   allows explicitly-added test users to connect)
# - APIs & Services > Credentials > Create OAuth client ID: Application
#   type "Web application"
# - Authorized redirect URI: {APP_URL}/integrations/backups/google_drive
#   /callback
# - Scope requested at connect time (not configured here, see
#   GoogleDriveBackupProvider::SCOPES): https://www.googleapis.com/auth/drive
#   — full Drive access is needed because a firm picks their shared drive
#   *after* connecting (searchDestinations()/selectDestination()); the
#   narrower drive.file scope only sees files this app itself created,
#   which would break the "browse and pick an existing shared drive" step.
#   This scope is sensitive enough that Google requires an app verification
#   review before the consent screen can leave "Testing" for real firms to
#   use — start that review early, it is not instant.
# - GOOGLE_BACKUP_CLIENT_ID / GOOGLE_BACKUP_CLIENT_SECRET — shown once the
#   OAuth client is created; the secret can be regenerated later if lost
GOOGLE_BACKUP_CLIENT_ID=
GOOGLE_BACKUP_CLIENT_SECRET=

# Blank disables archive encryption entirely (config/backup.php reads this
# as spatie/laravel-backup's 'password' — set to null skips encryption
# regardless of the 'encryption' key). Set a strong value before this ships
# anywhere near production data.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

SCOPE_SOLICITORS=false

# Local LLM via Ollama, reached over the WireGuard tunnel to the Mac Mini.
OLLAMA_URL=http://10.10.0.1:11434
OLLAMA_MODEL=qwen3:8b

VITE_APP_NAME="${APP_NAME}"
